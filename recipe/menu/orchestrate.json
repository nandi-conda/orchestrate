{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://schemas.conda.io/menuinst-1.schema.json",
  "menu_name": "Orchestrator",
  "menu_items": [
    {
      "name": "Orchestrator",
      "description": "Project-based agent orchestrator",
      "icon": "{{ MENU_DIR }}/orchestrate.{{ ICON_EXT }}",
      "command": ["{{ PREFIX }}/bin/orchestrate"],
      "platforms": {
        "linux": {
          "Categories": ["Development"],
          "StartupWMClass": "Orchestrator"
        },
        "osx": {
          "CFBundleName": "Orchestrator",
          "CFBundleDisplayName": "Orchestrator",
          "CFBundleIdentifier": "com.github.nandi-conda.orchestrate"
        },
        "win": {
          "command": ["{{ PREFIX }}/Scripts/orchestrate.exe"],
          "desktop": false
        }
      }
    }
  ]
}
